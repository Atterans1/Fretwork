@@ -49,26 +49,23 @@ void OutputStage::setParams (const OutputParams& p)
 
     const float room = clampf (p_.room01, 0.f, 1.f);
 
-    // Room types: size, damping and brightness from a small measured-style set.
-    // Booth: tiny and dead. Room: mid room. Hall: big and long. Plate: bright
-    // and dense with almost no early-reflection colour.
-    switch (std::clamp (p_.roomType, 0, 3))
-    {
-        case 0:  reverbParams_.roomSize = 0.10f + 0.15f * room; reverbParams_.damping = 0.85f; break;   // Booth
-        case 1:  reverbParams_.roomSize = 0.25f + 0.30f * room; reverbParams_.damping = 0.55f; break;   // Room
-        case 2:  reverbParams_.roomSize = 0.60f + 0.35f * room; reverbParams_.damping = 0.35f; break;   // Hall
-        default: reverbParams_.roomSize = 0.50f + 0.30f * room; reverbParams_.damping = 0.15f; break;   // Plate
-    }
-    float wetScale = 1.0f;
-    switch (std::clamp (p_.roomType, 0, 3))
-    {
-        case 0: wetScale = 0.6f; break;    // Booth: dry-ish
-        case 1: wetScale = 1.0f; break;    // Room
-        case 2: wetScale = 1.6f; break;    // Hall: big and washy
-        default: wetScale = 1.3f; break;   // Plate
-    }
-    reverbParams_.wetLevel = 0.60f * room * wetScale;
-    reverbParams_.dryLevel = 1.0f - 0.30f * room;
+    // Room types set comb feedback (size, which sets RT60) and damping (how fast
+    // highs decay). Booth short and dead, Room medium, Hall long, Plate bright
+    // and dense. JUCE feedback = size * 0.28 + 0.7, so size stays under 0.8 for Hall.
+    const int type = std::clamp (p_.roomType, 0, 3);
+    static constexpr float kSizeMin[4]   = { 0.00f, 0.55f, 0.70f, 0.55f };
+    static constexpr float kSizeRange[4] = { 0.10f, 0.05f, 0.10f, 0.15f };
+    static constexpr float kDamping[4]   = { 0.85f, 0.55f, 0.35f, 0.15f };
+    reverbParams_.roomSize = kSizeMin[type] + kSizeRange[type] * room;
+    reverbParams_.damping  = kDamping[type];
+
+    // Wet follows sqrt(room) so a low Room Level still sits under the release.
+    // Linear wet left the default about 27 dB under the note and gone in about 1 s.
+    static constexpr float kWetScale[4] = { 0.6f, 1.0f, 1.0f, 1.0f };
+    reverbParams_.wetLevel = 0.6f * std::sqrt (room) * kWetScale[type];
+    // JUCE multiplies dryLevel by 2. Room off bypasses the reverb (dry at 1.0),
+    // so 0.5 keeps the dry at 1.0 at every room setting.
+    reverbParams_.dryLevel = 0.5f;
     // Width also narrows the room: a full-width reverb made "Width 0" stereo.
     reverbParams_.width    = clampf (p_.width01, 0.f, 1.f);
 
