+    // Wet follows sqrt(room) so a low Room Level still sits under the release.
+    // Linear wet left the default about 27 dB under the note and gone in about 1 s.
+    static constexpr float kWetScale[4] = { 0.6f, 1.0f, 1.0f, 1.0f };
+    reverbParams_.wetLevel = 0.6f * std::sqrt (room) * kWetScale[type];
+    // JUCE multiplies dryLevel by 2. Room off bypasses the reverb (dry at 1.0),
+    // so 0.5 keeps the dry at 1.0 at every room setting.
+    reverbParams_.dryLevel = 0.5f;
