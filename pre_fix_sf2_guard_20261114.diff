+    const int type = std::clamp (p_.roomType, 0, 3);
+    static constexpr float kSizeMin[4]   = { 0.00f, 0.55f, 0.70f, 0.55f };
+    static constexpr float kSizeRange[4] = { 0.10f, 0.05f, 0.10f, 0.15f };
